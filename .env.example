## Danella base URL
DANELLA_BASE_URL=https://danella-x.com

## Credentials
DANELLA_USERNAME=
DANELLA_PASSWORD=

## Login probing options
# Usually something like /Account/Login or /Login
DANELLA_LOGIN_PAGE_PATH=/Account/Login
# Leave empty to auto-detect from form action on login page
DANELLA_LOGIN_POST_PATH=
# Form field names (change if Danella expects different keys)
DANELLA_LOGIN_USERNAME_FIELD=username
DANELLA_LOGIN_PASSWORD_FIELD=password
DANELLA_TOKEN_FIELD=__RequestVerificationToken

## Task endpoint to probe after login
# This can be relative path (recommended) or absolute URL
# Example: /Task/GetTasks?subProjectID=15&page=1&limit=10
DANELLA_TASK_URL=

## Optional timeout for each HTTP call (ms)
PROBE_TIMEOUT_MS=30000
