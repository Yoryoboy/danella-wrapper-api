## API server
NODE_ENV=development
PORT=3000
API_VERSION=v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

## Danella base URL
DANELLA_BASE_URL=https://danella-x.com
DANELLA_TIMEOUT_MS=30000

## Danella auth flow
# Leave login post path empty to auto-detect from login form action.
DANELLA_LOGIN_PAGE_PATH=/Home/Login
DANELLA_LOGIN_POST_PATH=
DANELLA_LOGIN_USERNAME_FIELD=Username
DANELLA_LOGIN_PASSWORD_FIELD=Password
DANELLA_TOKEN_FIELD=__RequestVerificationToken
DANELLA_VALIDATE_PATH=/Task/MyTasks
DANELLA_LOGOUT_PATH=/Home/Logout

## Probe script options
# This can be relative path (recommended) or absolute URL.
DANELLA_TASK_URL=/Task/MyTasks
PROBE_TIMEOUT_MS=30000
