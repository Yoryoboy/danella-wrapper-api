## Danella base URL
DANELLA_BASE_URL=https://danella-x.com

## Credentials
DANELLA_USERNAME=jdiaz
DANELLA_PASSWORD='G#z"U12>a5#'

## Login probing options
# Danella login page
DANELLA_LOGIN_PAGE_PATH=/Home/Login
# Leave empty to auto-detect from form action on login page
DANELLA_LOGIN_POST_PATH=
# Field names are auto-detected from the HTML form when possible
DANELLA_LOGIN_USERNAME_FIELD=jdiaz
DANELLA_LOGIN_PASSWORD_FIELD='G#z"U12>a5#'
DANELLA_TOKEN_FIELD=__RequestVerificationToken

## Task endpoint to probe after login
# This can be relative path (recommended) or absolute URL
# Example: /Task/TaskSubProject?SubProjectID=15
DANELLA_TASK_URL=/Task/MyTasks

## Optional timeout for each HTTP call (ms)
PROBE_TIMEOUT_MS=30000
